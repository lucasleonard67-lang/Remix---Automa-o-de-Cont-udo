# Supabase da instância (mesmos do frontend)
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
# Usuário ADMIN dedicado ao worker (password grant; RLS manda)
WORKER_EMAIL=worker@instancia.com
WORKER_PASSWORD=...
# ElevenLabs
ELEVEN_API_KEY=sk_...
ELEVEN_VOICE_ID=SEU_VOICE_ID
# Higgsfield MCP (OAuth da conta; tokens em hf-tokens.json)
HF_MCP_CLIENT_ID=...
HF_MCP_TOKEN_FILE=./hf-tokens.json
# Binários (setup-ffmpeg.sh preenche ./bin)
FFMPEG=./bin/ffmpeg
FFPROBE=./bin/ffprobe
POLL_SECONDS=15
